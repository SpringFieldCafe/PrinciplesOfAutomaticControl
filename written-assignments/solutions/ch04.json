        {
          "type": "eq",
          "latex": "e_r(t)=-\\frac78+\\left(\\frac{15}{16}+\\frac{393}{16\\sqrt{1905}}\\right)e^{-\\alpha t}+\\left(\\frac{15}{16}-\\frac{393}{16\\sqrt{1905}}\\right)e^{-\\beta t},\\quad t\\ge0."
        },
